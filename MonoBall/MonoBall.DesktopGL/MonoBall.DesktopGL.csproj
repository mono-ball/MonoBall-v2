<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AssemblyName>MonoBall</AssemblyName>
    <LangVersion>default</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoBall.Core\MonoBall.Core.csproj" />
    <ProjectReference Include="..\MonoBall.ArchiveTool\MonoBall.ArchiveTool.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-preview.1" />
  </ItemGroup>

  <!-- Mod-related build targets -->
  <PropertyGroup>
    <!-- Mods directory is at repo root, relative to this project -->
    <!-- Use forward slashes for cross-platform compatibility (MSBuild normalizes paths) -->
    <ModsSourceDir>$(MSBuildProjectDirectory)/../../Mods</ModsSourceDir>
    <ModsOutputDir>$(OutputPath)Mods</ModsOutputDir>
    <!-- ArchiveTool executable path (platform-specific) -->
    <ArchiveToolDir>$(MSBuildProjectDirectory)/../MonoBall.ArchiveTool/bin/$(Configuration)/$(TargetFramework)</ArchiveToolDir>
    <ArchiveToolExe Condition="'$(OS)' == 'Windows_NT'">$(ArchiveToolDir)/MonoBall.ArchiveTool.exe</ArchiveToolExe>
    <ArchiveToolExe Condition="'$(OS)' != 'Windows_NT'">$(ArchiveToolDir)/MonoBall.ArchiveTool</ArchiveToolExe>
  </PropertyGroup>

  <!-- Copy mods to output directory after build -->
  <Target Name="CopyModsToOutput" AfterTargets="Build">
    <PropertyGroup>
      <ModsOutputDir>$(OutputPath)Mods</ModsOutputDir>
    </PropertyGroup>

    <!-- Create Mods output directory -->
    <MakeDir Directories="$(ModsOutputDir)" Condition="!Exists('$(ModsOutputDir)')" />

    <!-- Copy mod.manifest if it exists -->
    <Copy SourceFiles="$(ModsSourceDir)/mod.manifest"
          DestinationFolder="$(ModsOutputDir)"
          Condition="Exists('$(ModsSourceDir)/mod.manifest')"
          SkipUnchangedFiles="true" />

    <!-- Copy all .monoball archives -->
    <ItemGroup>
      <ModArchives Include="$(ModsSourceDir)/*.monoball" />
    </ItemGroup>
    <Copy SourceFiles="@(ModArchives)"
          DestinationFolder="$(ModsOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Standalone target: Copy mods to output directory -->
  <Target Name="CopyMods" DependsOnTargets="Build">
    <CallTarget Targets="CopyModsToOutput" />
  </Target>

  <!-- Standalone target: Compile mod shaders -->
  <Target Name="CompileModShaders">
    <PropertyGroup>
      <ShaderExtension>.fx</ShaderExtension>
      <CompiledShaderExtension>.mgfxo</CompiledShaderExtension>
      <ShaderProfile>OpenGL</ShaderProfile>
    </PropertyGroup>

    <!-- Check if Mods directory exists -->
    <Error Condition="!Exists('$(ModsSourceDir)')"
           Text="Mods directory not found: $(ModsSourceDir)" />

    <!-- Find all .fx shader files in Mods directory -->
    <ItemGroup>
      <ShaderFiles Include="$(ModsSourceDir)/**/*$(ShaderExtension)" />
    </ItemGroup>

    <!-- Compile each shader using dotnet tool run mgfxc -->
    <Exec Command="dotnet tool run mgfxc -- &quot;%(ShaderFiles.FullPath)&quot; &quot;%(ShaderFiles.RelativeDir)%(ShaderFiles.Filename)$(CompiledShaderExtension)&quot; /Profile:$(ShaderProfile)"
          ContinueOnError="true"
          Condition="'@(ShaderFiles)' != ''">
      <Output TaskParameter="ExitCode" ItemName="ShaderCompileExitCode" />
    </Exec>

    <Message Text="Shader compilation complete. Processed @(ShaderFiles->Count()) shader(s)."
             Condition="'@(ShaderFiles)' != ''" />
    <Warning Text="No shader files found in $(ModsSourceDir)"
             Condition="'@(ShaderFiles)' == ''" />
  </Target>

  <!-- Standalone target: Compress mods to .monoball archives -->
  <Target Name="CompressMods" DependsOnTargets="BuildArchiveTool">
    <PropertyGroup>
      <ArchiveExtension>.monoball</ArchiveExtension>
      <CompressionLevel>1</CompressionLevel>
    </PropertyGroup>

    <!-- Check if Mods directory exists -->
    <Warning Condition="!Exists('$(ModsSourceDir)')"
             Text="Mods directory not found: $(ModsSourceDir). Skipping mod compression." />

    <!-- Check if ArchiveTool exists -->
    <Error Condition="!Exists('$(ArchiveToolExe)')"
           Text="ArchiveTool executable not found: $(ArchiveToolExe). Ensure BuildArchiveTool target completed successfully." />

    <!-- Find all mod directories (exclude .monoball files) -->
    <!-- Use a custom task to filter directories only -->
    <ItemGroup>
      <ModDirectories Include="$(ModsSourceDir)/*" />
      <ModDirectories Remove="$(ModsSourceDir)/*.monoball" />
    </ItemGroup>

    <!-- Compress each mod directory -->
    <!-- Use MSBuild property function to get directory name -->
    <Exec Command="&quot;$(ArchiveToolExe)&quot; pack &quot;%(ModDirectories.Identity)&quot; --output &quot;$(ModsSourceDir)/$([System.IO.Path]::GetFileName('%(ModDirectories.Identity)'))$(ArchiveExtension)&quot; --compression-level $(CompressionLevel)"
          ContinueOnError="false"
          Condition="'@(ModDirectories)' != '' and Exists('$(ArchiveToolExe)') and $([System.IO.Directory]::Exists('%(ModDirectories.Identity)'))" />

    <Message Text="Mod compression complete. Compressed @(ModDirectories->Count()) mod(s)."
             Condition="'@(ModDirectories)' != ''" />
    <Warning Text="No mod directories found in $(ModsSourceDir)"
             Condition="'@(ModDirectories)' == ''" />
  </Target>

  <!-- Restore NuGet packages for all projects (ensures dependencies are available) -->
  <Target Name="RestoreProjects">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../MonoBall.Core/MonoBall.Core.csproj"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             Targets="Restore" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../MonoBall.ArchiveTool/MonoBall.ArchiveTool.csproj"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             Targets="Restore" />
  </Target>

  <!-- Build ArchiveTool before compressing mods -->
  <Target Name="BuildArchiveTool" DependsOnTargets="RestoreProjects">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../MonoBall.ArchiveTool/MonoBall.ArchiveTool.csproj"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             Targets="Build" />
  </Target>
</Project>
